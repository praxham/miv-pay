{
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "bunVersion": "1.4.x",
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/api/docs"
    },
    {
      "source": "/pay",
      "destination": "/api/pay"
    },
    {
      "source": "/pay/",
      "destination": "/api/pay"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
